{
  "name": "lexia-reader",
  "displayName": "LEXIA",
  "description": "LEXIA AI assistant for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:lexia-reader.analyzeFile",
    "onView:lexia-reader.chat"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "lexia-reader.analyzeFile",
        "title": "LEXIA: Analyze Current File"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lexia",
          "title": "LEXIA",
          "icon": "media/lexia.svg"
        }
      ]
    },
    "views": {
      "lexia": [
        {
          "type": "webview",
          "id": "lexia-reader.chat",
          "name": "LEXIA"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
